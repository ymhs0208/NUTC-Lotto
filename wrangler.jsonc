{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "special-exhibition-lottery",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "keep_vars": true,
  "build": { "command": "npm run build" },
  "routes": [{ "pattern": "lottery.nutc.cc.cd", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [{ "name": "LOGIN_LIMITER", "class_name": "LoginLimiter" }, { "name": "API_BACKEND", "class_name": "ApiBackend" }, { "name": "LOTTERY_DATABASE", "class_name": "LotteryDatabase" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LoginLimiter", "ApiBackend"] }, { "tag": "v2", "new_sqlite_classes": ["LotteryDatabase"] }],
  "observability": { "enabled": true }
}
