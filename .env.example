# Generate a random secret: openssl rand -hex 32
SESSION_SECRET=REPLACE_WITH_A_RANDOM_SECRET
# First administrator only. Generate the hash with npm run staff:hash.
ADMIN_EMAIL=admin@example.edu.tw
ADMIN_PASSWORD_HASH=scrypt-v1$REPLACE_WITH_GENERATED_HASH
# Node local development only; Cloudflare uses LOTTERY_DB automatically.
SQLITE_PATH=data/lottery.sqlite
PORT=3000
# Enable only after firewall/proxy rules restrict all entry points to campus networks.
# CAMPUS_NETWORK_ONLY=true
# Node default 8; Workers default 1 (maximum 2 after capacity validation).
# PASSWORD_HASH_CONCURRENCY=8
