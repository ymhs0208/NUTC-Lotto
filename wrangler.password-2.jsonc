{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nutc-lotto-password-2",
  "main": "worker/passwordVerifier.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      {
        "name": "PASSWORD_WORK",
        "class_name": "PasswordVerifier"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "PasswordVerifier"
      ]
    }
  ],
  "observability": {
    "enabled": true
  }
}
