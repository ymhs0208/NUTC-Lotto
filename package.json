{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/start-server.mjs",
    "build": "vite build",
    "start": "node scripts/start-server.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:load": "tsx scripts/load-test-students.ts",
    "test:password-load": "tsx scripts/load-test-password-pools.ts",
    "test:password-cloud": "tsx scripts/cloudflare-password-benchmark.ts",
    "migrate:local": "tsx scripts/migrate-local-data.ts",
    "dev:cloudflare": "npm run build && wrangler dev",
    "dev:distributed": "npm run build && wrangler dev -c wrangler.distributed.jsonc -c wrangler.password-0.jsonc -c wrangler.password-1.jsonc -c wrangler.password-2.jsonc -c wrangler.password-3.jsonc",
    "deploy:passwords": "node scripts/password-pools.mjs deploy",
    "check:passwords": "node scripts/password-pools.mjs check",
    "deploy": "npm run build && wrangler deploy",
    "deploy:check": "npm run build && wrangler deploy --dry-run",
    "deploy:distributed": "npm run build && npm run deploy:passwords && wrangler deploy -c wrangler.distributed.jsonc",
    "check:distributed": "npm run build && npm run check:passwords && wrangler deploy -c wrangler.distributed.jsonc --dry-run",
    "test:cloudflare": "CLOUDFLARE_TEST=1 tsx --test tests/backend.test.ts",
    "staff:hash": "tsx scripts/hash-staff-password.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260930.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.145.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@10.11.1"
}
